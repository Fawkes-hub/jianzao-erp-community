# 简造ERP社区版 · 前端环境变量示例
# 复制为 .env.development（或对应 mode 的 .env.*）后按需修改。
# .env* 已被 .gitignore 排除，切勿提交真实密钥。

VITE_APP_TITLE=简造ERP社区版
VITE_APP_LOGO_TITLE=简造ERP社区版
VITE_APP_ENV=development
VITE_APP_BASE_API=/prod-api
VITE_APP_CONTEXT_PATH=/
VITE_APP_PORT=80

# 登录密码 RSA 加密：请自行生成密钥对，禁止使用示例值
VITE_APP_ENCRYPT=true
VITE_APP_RSA_PUBLIC_KEY=REPLACE_WITH_YOUR_PUBLIC_KEY
VITE_APP_RSA_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
VITE_APP_CLIENT_ID=community-client-id-000001

VITE_APP_WEBSOCKET=false
VITE_APP_SSE=false
