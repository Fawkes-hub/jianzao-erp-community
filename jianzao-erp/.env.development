# 简造ERP社区版 · 开发环境
# 本文件是公开模板，请勿写入真实密钥；个人覆盖项写进 .env.development.local（已被 .gitignore 排除）

VITE_APP_TITLE=简造ERP社区版
VITE_APP_LOGO_TITLE=简造ERP社区版
VITE_APP_ENV=development

# 与 deploy/nginx 的代理前缀保持一致，避免本地联调与线上路径不一致
VITE_APP_BASE_API=/prod-api
VITE_APP_CONTEXT_PATH=/

# 开发服务器端口。80 需要 root 权限，普通用户请保持 5173
VITE_APP_PORT=5173
# 后端地址，需与 application.yml 的 server.port 一致
VITE_APP_PROXY_TARGET=http://localhost:8080

# 接口加密：默认关闭，与后端 api-decrypt.enabled=false 对应
# 如需开启，见 jianzao-backend/.../application.yml 中 api-decrypt 的注释
VITE_APP_ENCRYPT=false
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=

# 客户端标识，需与 deploy/mysql/init/01-ruoyi-system.sql 的 sys_client 记录一致
VITE_APP_CLIENT_ID=community-client-id-000001

VITE_APP_WEBSOCKET=false
VITE_APP_SSE=false
