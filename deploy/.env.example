# 简造ERP社区版 · Docker Compose 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，切勿提交真实凭据。
# 生成随机值：openssl rand -hex 32

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-with-openssl-rand-hex-32

# 同源部署留空即可；公网域名/IP 部署时按实际来源配置（逗号分隔）
SECURITY_CORS_ALLOWED_ORIGINS=

# JVM 内存上限（2C4G 机器可保持默认）
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m

# 前端构建产物目录（pnpm build 后指向 dist）
FRONTEND_DIST=./frontend-dist
