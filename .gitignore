# 依赖与构建产物
node_modules/
dist/
target/
build/
.flattened-pom.xml
*.log

# 锁文件对可复现构建必需，保留（前端子仓 .gitignore 默认排除，此处覆盖）
!pnpm-lock.yaml

# 环境变量：密钥与品牌配置一律不入库
# 公开仓只保留无密钥的模板；任何 *.local / 带真实凭据的 .env 不入库
.env
.env.*
!.env.example
!.env.development
!.env.production

# 编辑器 / 系统
.idea/
.vscode/
.zcode/
.openidea/
.workbuddy/
*.iml
.DS_Store
Thumbs.db

# 生成物（由插件自动生成，不入库）
.eslintrc-auto-import.json
src/types/auto-imports.d.ts
src/types/components.d.ts

# 本地数据与备份
deploy/.env
deploy/app/
deploy/frontend-dist/
deploy/environments/*.conf
deploy/backup/
deploy/data/
deploy/.release-logs/
*.sql.bak

# 生成的发布包
*.exe
*.zip
*.tar.gz
